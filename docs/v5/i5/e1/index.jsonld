    {
      "@id": "https://w3id.org/squirrelpapers/v5/i5/e1",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:Presentation",
        "lrmoo:F2_Expression"
      ],
      "bibo:abstract": {
        "@language": "en",
        "@value": "NFDI4Objects (N4O) represents a broad community dealing with material remains of human history from around 3 million years and involves numerous disciplines from the humanities, cultural studies and natural sciences with an archaeological and historical focus [1]. The objects examined include potsherds of common ware, artworks such as sculptures or jewellery, serially produced objects such as coins, organic remains such as wood, bones or pollen, inscribed clay tablets, papyri and stones, architectural remains, as well as human-modified landscapes. Modern research materials such as plaster casts, analogue photographs and drawings, archival documents, books and raw digital data are equally relevant."
      },
      "bibo:authorList": {
        "@id": "https://w3id.org/squirrelpapers/v5/i5/e1#authors"
      },
