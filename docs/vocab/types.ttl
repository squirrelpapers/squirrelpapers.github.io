sqpt:abstract a crm:E55_Type,
        skos:Concept ;
    rdfs:seeAlso fabio:Abstract ;
    skos:closeMatch <http://purl.org/coar/resource_type/c_c94f> ;
    skos:inScheme sqpt: ;
    skos:notation "abstract" ;
    skos:prefLabel "Abstract"@de,
        "Abstract"@en ;
    skos:topConceptOf sqpt: .

