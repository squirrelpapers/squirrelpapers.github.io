    {
      "@id": "https://w3id.org/squirrelpapers/v1/i2/e4#title",
      "@type": "crm:E35_Title",
      "crm:P190_has_symbolic_content": "ARS3D - Documenting facts and interpretations of African Red Slip Ware"
