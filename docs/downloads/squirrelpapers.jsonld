    {
      "@id": "https://w3id.org/squirrelpapers/v6/i3/e6#title",
      "@type": "crm:E35_Title",
      "crm:P190_has_symbolic_content": "Modellierung von Fuzzyness & Wobbliness in Geodaten am Beispiel archäologischer und geowissenschaftlicher Fundorte"
