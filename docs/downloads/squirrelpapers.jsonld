          "@id": "sqpt:conference-paper"
        },
        {
          "@id": "sqpt:poster"
        }
      ],
      "dcat:distribution": {
        "@id": "https://w3id.org/squirrelpapers/v6/i3/e4#pdf"
      },
      "dcat:inSeries": {
        "@id": "https://w3id.org/squirrelpapers/v6/i3"
