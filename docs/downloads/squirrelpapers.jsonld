      "dct:creator": [
        {
          "@id": "https://w3id.org/squirrelpapers/person/0000-0002-3246-3531"
        },
        {
          "@id": "https://w3id.org/squirrelpapers/person/0000-0002-4088-255X"
        },
        {
          "@id": "https://w3id.org/squirrelpapers/person/0000-0002-7634-5342"
        },
        {
          "@id": "https://w3id.org/squirrelpapers/person/0000-0002-8604-544X"
        },
        {
          "@id": "https://w3id.org/squirrelpapers/person/0000-0002-9695-0240"
        },
        {
          "@id": "https://w3id.org/squirrelpapers/person/0000-0002-9823-5507"
