    {
      "@id": "https://w3id.org/squirrelpapers/v5/i1/e2#title",
      "@type": "crm:E35_Title",
      "crm:P190_has_symbolic_content": "Alligator Method"
    },
    {
      "@id": "https://w3id.org/squirrelpapers/v5/i1/e3",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:BookChapter",
        "lrmoo:F2_Expression"
      ],
      "bibo:abstract": {
        "@language": "de",
        "@value": "ᚑᚌᚆᚐᚋ (Ogham) Steine sind mit der frühmittelalterlichen Ogham-Schrift versehene Monolithen, die vor allem in Irland, zwischen dem 4. und 9. Jahrhundert errichtet wurden. Viele von ihnen sind in “der freien Wildbahn” oder in Museen für die “Volunteer Community” einsehbar. Dieser Vortrag beschreibt die Dokumentation, Modellierung und Veröffentlichung dieser archäologischen Fundgattung in Community Hubs wie OSM und Wikidata mit der Nutzung von Linked Open Data Technologien.\nMehr auch unter https://pretalx.com/fossgis2023/talk/Y8JWWP/"
      },
      "bibo:authorList": {
        "@id": "https://w3id.org/squirrelpapers/v5/i1/e3#authors"
      },
      "bibo:doi": "10.5281/zenodo.7870480",
      "bibo:locator": "#3",
      "crm:P102_has_title": {
        "@id": "https://w3id.org/squirrelpapers/v5/i1/e3#title"
      },
      "crm:P106i_forms_part_of": {
        "@id": "https://w3id.org/squirrelpapers/v5/i1"
      },
