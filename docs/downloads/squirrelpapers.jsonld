    {
      "@id": "https://w3id.org/squirrelpapers/v1/i1/e4",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:WorkingPaper",
        "lrmoo:F2_Expression"
      ],
      "bibo:abstract": {
        "@language": "en",
        "@value": "The Linked Geodesy Research Project topi.link combines geodesy and Linked Data research questions. Using the Academic\nMeta Tool (AMT), we have a little minion, which addresses the task of inferencing vague graph data. topi.link will give\naccess to the AMT world using toponyms as a graph-based vague topology for these toponyms. This paper demonstrates a\nvery simple example how to model a north/south ontology using AMT."
      },
      "bibo:authorList": {
        "@id": "https://w3id.org/squirrelpapers/v1/i1/e4#authors"
      },
      "bibo:doi": "10.5281/zenodo.2635490",
      "bibo:locator": "#4",
      "crm:P102_has_title": {
        "@id": "https://w3id.org/squirrelpapers/v1/i1/e4#title"
      },
      "crm:P106i_forms_part_of": {
        "@id": "https://w3id.org/squirrelpapers/v1/i1"
      },
      "crm:P1_is_identified_by": {
        "@id": "https://w3id.org/squirrelpapers/v1/i1/e4#doi"
      },
      "crm:P2_has_type": {
        "@id": "sqpt:working-paper"
      },
      "dcat:distribution": {
        "@id": "https://w3id.org/squirrelpapers/v1/i1/e4#pdf"
      },
      "dcat:inSeries": {
        "@id": "https://w3id.org/squirrelpapers/v1/i1"
      },
      "dcat:keyword": [
        "Conceptual Modeling",
        "Linked Data",
        "Semantic Reasoning",
        "Vagueness"
      ],
      "dcat:landingPage": {
        "@id": "https://squirrelpapers.github.io/v1/i1/e4/"
      },
      "dcat:theme": {
        "@id": "sqpt:working-paper"
      },
      "dct:creator": {
        "@id": "https://w3id.org/squirrelpapers/person/0000-0002-3246-3531"
      },
      "dct:description": {
        "@language": "en",
        "@value": "The Linked Geodesy Research Project topi.link combines geodesy and Linked Data research questions. Using the Academic\nMeta Tool (AMT), we have a little minion, which addresses the task of inferencing vague graph data. topi.link will give\naccess to the AMT world using toponyms as a graph-based vague topology for these toponyms. This paper demonstrates a\nvery simple example how to model a north/south ontology using AMT."
      },
      "dct:identifier": "https://doi.org/10.5281/zenodo.2635490",
