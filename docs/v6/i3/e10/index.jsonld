    {
      "@id": "https://w3id.org/squirrelpapers/v6/i3/e10",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:Presentation",
        "lrmoo:F2_Expression"
