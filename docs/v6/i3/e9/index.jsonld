    {
      "@id": "https://w3id.org/squirrelpapers/v6/i3/e9",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:ConferencePoster",
        "lrmoo:F2_Expression"
