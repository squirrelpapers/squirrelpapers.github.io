    {
      "@id": "https://w3id.org/squirrelpapers/v6/i4/e21",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:ConferencePoster",
        "lrmoo:F2_Expression"
