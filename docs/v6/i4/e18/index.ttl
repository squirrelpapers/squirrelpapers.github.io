<https://w3id.org/squirrelpapers/v6/i4/e18> a lrmoo:F2_Expression,
        bibo:Document,
        fabio:Expression,
        crm:E73_Information_Object,
        dcat:Dataset ;
    prism:number "4" ;
    prism:volume "6" ;
    dct:creator <https://w3id.org/squirrelpapers/person/0000-0002-3246-3531>,
        <https://w3id.org/squirrelpapers/person/0000-0002-9953-7638>,
        <https://w3id.org/squirrelpapers/person/rutenik-tobias-arera> ;
    dct:description "Den Teilnehmenden soll die aktive Arbeit mit Linked Open Data nähergebracht werden. Ihnen werden digitale Werkzeuge (hier QGIS, Wikidata und Wikibase) vorgestellt und eine Einführung darin gegeben. Im Mittelpunkt stehen die Modellierung von Daten in Wikibase-Instanzen und das dynamische Abfragen mit Hilfe von Open Source Tools, wie das SPARQLing Unicorn QGIS Plugin, bzw. online unter: http://nomisma.org/sparql/. Einführung in die einfache Erzeugung von RDF-Daten aus CSV-Dateien (z.B. durch die Nutzung von RDFier)."@de ;
    dct:identifier "https://doi.org/10.5281/zenodo.13927753" ;
    dct:isPartOf <https://w3id.org/squirrelpapers/v6/i4> ;
    dct:issued "2024-09-25"^^xsd:date ;
    dct:language eulang:DEU ;
    dct:license <https://creativecommons.org/licenses/by/4.0/> ;
    dct:publisher <https://w3id.org/squirrelpapers/org/research-squirrel-engineers> ;
    dct:title "Workshop III: Linked Open Data am Beispiel von RDF-Daten, Wikidata und Wikibase"@de ;
    dct:type sqpt:workshop ;
    bibo:abstract "Den Teilnehmenden soll die aktive Arbeit mit Linked Open Data nähergebracht werden. Ihnen werden digitale Werkzeuge (hier QGIS, Wikidata und Wikibase) vorgestellt und eine Einführung darin gegeben. Im Mittelpunkt stehen die Modellierung von Daten in Wikibase-Instanzen und das dynamische Abfragen mit Hilfe von Open Source Tools, wie das SPARQLing Unicorn QGIS Plugin, bzw. online unter: http://nomisma.org/sparql/. Einführung in die einfache Erzeugung von RDF-Daten aus CSV-Dateien (z.B. durch die Nutzung von RDFier)."@de ;
