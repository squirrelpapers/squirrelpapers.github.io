    {
      "@id": "https://w3id.org/squirrelpapers/v8/i3/e4",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:ConferencePoster",
        "lrmoo:F2_Expression"
