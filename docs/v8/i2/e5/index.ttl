<https://w3id.org/squirrelpapers/v8/i2/e5#title> a crm:E35_Title ;
    crm:P190_has_symbolic_content "FAIRyland: A playful dataset for teaching Linked Open Data in archaeology" .

<https://w3id.org/squirrelpapers/v8/i2/e5> a lrmoo:F2_Expression,
        bibo:Document,
        fabio:Dataset,
        crm:E73_Information_Object,
        dcat:Dataset ;
    prism:number "2" ;
    prism:volume "8" ;
    dct:creator <https://w3id.org/squirrelpapers/person/0000-0002-3246-3531>,
        <https://w3id.org/squirrelpapers/person/0000-0002-4088-255X>,
        <https://w3id.org/squirrelpapers/person/alpino-nadine> ;
    dct:description "FAIRyland is an open educational resource (OER) combining fictional archaeology with real research software engineering methods. The dataset simulates a Minion Period archaeological site in northern Sweden, featuring craters, streets, petrified kangaroo droppings (Kötbullar), and other playful features. It demonstrates the complete workflow from QGIS vector data to RDF/Linked Open Data using the SPARQLing Unicorn plugin, followed by SPARQL querying and Python-based visualisation. The repository includes geospatial data (GeoJSON, GeoPackage), RDF triples in Turtle format with CIDOC-CRM and GeoSPARQL vocabularies, seven interactive SPARQL queries, Python scripts for data analysis and visualisation (rdflib, pandas, matplotlib, GeoPandas), and Jupyter Notebooks for hands-on learning. FAIRyland serves as a practical sandbox for students and researchers to learn semantic web technologies, geospatial analysis, and FAIR data principles through an accessible, playful framework."@en ;
    dct:identifier "https://doi.org/10.5281/zenodo.18901448" ;
    dct:isPartOf <https://w3id.org/squirrelpapers/v8/i2> ;
    dct:issued "2026-03-07"^^xsd:date ;
    dct:language eulang:ENG ;
    dct:license <https://spdx.org/licenses/MIT.html> ;
    dct:publisher <https://w3id.org/squirrelpapers/org/research-squirrel-engineers> ;
    dct:title "FAIRyland: A playful dataset for teaching Linked Open Data in archaeology"@en ;
    dct:type sqpt:data ;
    bibo:abstract "FAIRyland is an open educational resource (OER) combining fictional archaeology with real research software engineering methods. The dataset simulates a Minion Period archaeological site in northern Sweden, featuring craters, streets, petrified kangaroo droppings (Kötbullar), and other playful features. It demonstrates the complete workflow from QGIS vector data to RDF/Linked Open Data using the SPARQLing Unicorn plugin, followed by SPARQL querying and Python-based visualisation. The repository includes geospatial data (GeoJSON, GeoPackage), RDF triples in Turtle format with CIDOC-CRM and GeoSPARQL vocabularies, seven interactive SPARQL queries, Python scripts for data analysis and visualisation (rdflib, pandas, matplotlib, GeoPandas), and Jupyter Notebooks for hands-on learning. FAIRyland serves as a practical sandbox for students and researchers to learn semantic web technologies, geospatial analysis, and FAIR data principles through an accessible, playful framework."@en ;
    bibo:authorList <https://w3id.org/squirrelpapers/v8/i2/e5#authors> ;
    bibo:doi "10.5281/zenodo.18901448" ;
    bibo:locator "§5" ;
