    {
      "@id": "https://w3id.org/squirrelpapers/v1/i6/e3",
      "@type": [
        "bibo:Document",
        "crm:E73_Information_Object",
        "dcat:Dataset",
        "fabio:ConferencePoster",
        "lrmoo:F2_Expression"
