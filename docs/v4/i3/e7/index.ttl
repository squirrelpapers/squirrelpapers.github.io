    dct:publisher <https://w3id.org/squirrelpapers/org/research-squirrel-engineers> ;
    dct:title "Challenges & Opportunities from real world archaeological datasets in the community-driven LOD ecosystem"@en ;
    dct:type sqpt:presentation ;
