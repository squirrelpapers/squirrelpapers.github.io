<!doctype html>
<html lang="{{ lang }}">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>{{ page_title }}</title>
{% if description %}<meta name="description" content="{{ description }}">{% endif %}
<link rel="canonical" href="{{ canonical }}">
{% for alt in alternates %}<link rel="alternate" hreflang="{{ alt.lang }}" href="{{ alt.url }}">
{% endfor %}{% for link in data_links %}<link rel="alternate" type="{{ link.type }}" href="{{ link.href }}">
{% endfor %}<link rel="icon" type="image/png" href="{{ root }}assets/img/sqp-logo.png">
<script>
/* Light or dark before the first paint, so the page never flashes the other
   one: a choice made with the switch wins, else the system setting (CSS). */
(function () { try { var t = localStorage.getItem("sqp-theme");
  if (t === "light" || t === "dark") { document.documentElement.setAttribute("data-theme", t); }
} catch (e) {} }());
</script>
<link rel="stylesheet" href="{{ asset('assets/css/sqp.css') }}">
{% block head_extra %}{% endblock %}
{% if jsonld %}<script type="application/ld+json">{{ jsonld | safe }}</script>{% endif %}
</head>
<body>
<a class="skip" href="#main">{{ "Skip to content" if lang == "en" else "Zum Inhalt" }}</a>
<header class="site-header">
  <div class="wrap">
    <a class="site-title" href="{{ home }}">Squirrel Papers</a>
    <span class="site-tagline">{{ t.tagline }}</span>
    <nav class="site-nav" aria-label="{{ 'Main' if lang == 'en' else 'Hauptmenü' }}">
      <a href="{{ home }}"{% if nav == 'home' %} aria-current="page"{% endif %}>{{ t.nav_home }}</a>
      <a href="{{ home }}volumes/"{% if nav == 'volumes' %} aria-current="page"{% endif %}>{{ t.nav_volumes }}</a>
      <a href="{{ home }}search/"{% if nav == 'search' %} aria-current="page"{% endif %}>{{ t.nav_search }}</a>
      <a href="{{ home }}map/"{% if nav == 'map' %} aria-current="page"{% endif %}>{{ t.nav_map }}</a>
      <a href="{{ home }}model/"{% if nav == 'model' %} aria-current="page"{% endif %}>{{ t.nav_model }}</a>
      <a href="{{ home }}sparql/"{% if nav == 'sparql' %} aria-current="page"{% endif %}>{{ t.nav_sparql }}</a>
      <a href="{{ home }}impressum/"{% if nav == 'impressum' %} aria-current="page"{% endif %}>{{ t.nav_impressum }}</a>
      <a href="{{ home }}privacy/"{% if nav == 'privacy' %} aria-current="page"{% endif %}>{{ t.nav_privacy }}</a>
      <a class="lang-switch" href="{{ other_lang_href }}" hreflang="{{ other_lang }}" lang="{{ other_lang }}">{{ t.other_lang }}</a>
      <button type="button" class="theme-switch" id="theme-switch" hidden
              data-to-dark="{{ t.theme_to_dark }}" data-to-light="{{ t.theme_to_light }}"
              data-dark="{{ t.theme_dark }}" data-light="{{ t.theme_light }}"><svg viewBox="0 0 16 16" aria-hidden="true"><circle cx="8" cy="8" r="6.5" fill="none" stroke="currentColor" stroke-width="1.5"/><path d="M8 1.5a6.5 6.5 0 0 0 0 13z" fill="currentColor"/></svg><span></span></button>
    </nav>
  </div>
</header>
<main id="main">
{% block main %}{% endblock %}
</main>
<footer class="site-footer band">
  <div class="wrap footer-grid">
    <section>
      <h2>{{ t.about_title }}</h2>
      <p>{{ journal.description[lang] }}</p>
      <p>{{ journal.registration[lang] }}</p>
    </section>
    <section>
      <h2>{{ t.contact_title }}</h2>
      <p><strong>{{ t.mail }}</strong><br>{{ journal.contact }}</p>
      <p><strong>{{ t.editor_title }}</strong><br>
        <a href="https://orcid.org/{{ journal.editor.orcid }}">{{ editor_name }}</a></p>
      <p>{{ t.issn }} {{ journal.issn }} · <a href="https://www.wikidata.org/wiki/{{ journal.wikidata }}">{{ t.wikidata }}: {{ journal.wikidata }}</a></p>
    </section>
  </div>
  <div class="wrap footer-small">
    <p>{{ t.footer_licence }}</p>
    <p><a href="https://github.com/squirrelpapers/squirrelpapers.github.io">{{ t.source_code }}</a>
      · <a href="{{ home }}impressum/">{{ t.nav_impressum }}</a>
      · <a href="{{ home }}privacy/">{{ t.nav_privacy }}</a></p>
  </div>
</footer>
<script>
// Light / dark switch. Shows the mode it switches to; the choice is kept in
// this browser only (localStorage, no cookie) and announced to the map and
// diagram scripts with a "sqp-theme" event.
(function () {
  var button = document.getElementById("theme-switch");
  var root = document.documentElement;
  var system = window.matchMedia ? window.matchMedia("(prefers-color-scheme: dark)") : null;
  function current() {
    var t = root.getAttribute("data-theme");
    return t || (system && system.matches ? "dark" : "light");
  }
  function show() {
    var dark = current() === "dark";
    button.querySelector("span").textContent = button.getAttribute(dark ? "data-light" : "data-dark");
    button.setAttribute("aria-label", button.getAttribute(dark ? "data-to-light" : "data-to-dark"));
    button.title = button.getAttribute("aria-label");
  }
  button.addEventListener("click", function () {
    var next = current() === "dark" ? "light" : "dark";
    root.setAttribute("data-theme", next);
    try { localStorage.setItem("sqp-theme", next); } catch (e) {}
    show();
    document.dispatchEvent(new CustomEvent("sqp-theme", { detail: next }));
  });
  if (system && system.addEventListener) {
    system.addEventListener("change", function () {
      if (!root.getAttribute("data-theme")) {
        show();
        document.dispatchEvent(new CustomEvent("sqp-theme", { detail: current() }));
      }
    });
  }
  button.hidden = false;
  show();
}());

// Copy buttons. The PDF preview and the citation styles have their own scripts.
document.addEventListener("click", function (event) {
  var copy = event.target.closest("[data-copy]");
  if (copy && navigator.clipboard) {
    var text = document.getElementById(copy.getAttribute("data-copy")).innerText.trim();
    navigator.clipboard.writeText(text).then(function () {
      var label = copy.textContent;
      copy.textContent = copy.getAttribute("data-copied");
      setTimeout(function () { copy.textContent = label; }, 1500);
    });
  }
});
</script>
{% block scripts %}{% endblock %}
</body>
</html>
