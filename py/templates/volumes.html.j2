{% extends "base.html.j2" %}
{% block main %}
<div class="wrap">
  <h1>{{ t.nav_volumes }}</h1>
  {% for v in volumes %}
  <section class="volume-block">
    <h2><a href="{{ root }}{{ v.path }}/">{{ t.volume }} {{ v.volume }}</a> <span class="muted">{{ v.label_years }}</span></h2>
    <ul class="issue-list">
    {% for issue in v.issues %}
      <li><a href="{{ root }}{{ issue.path }}/">{{ t.issue }} {{ issue.issue }}</a>{% if issue.title %}: <em>{{ issue.title[lang] or issue.title.en }}</em>{% endif %}
        <span class="muted">({{ issue.published|length }} {{ t.entries }})</span></li>
    {% endfor %}
    </ul>
  </section>
  {% endfor %}
</div>
{% endblock %}
