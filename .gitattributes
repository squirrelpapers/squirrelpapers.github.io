# Generated files are written with LF on every platform (sqp_utils.write_text);
# keep git from converting them back, or a rebuild on Windows shows every file
# as modified.
* text=auto eol=lf
*.png binary
*.jpg binary
*.pdf binary
*.pfb binary
*.ttf binary
*.woff binary
*.woff2 binary
*.wasm binary
*.whl binary
*.zip binary
